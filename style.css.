
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #1e293b;
    line-height: 1.6;
}

header {
    background: #123c35;
    color: white;
    text-align: center;
    padding: 35px 15px;
}

header h1 {
    font-size: 38px;
    margin-bottom: 8px;
}

.container {
    max-width: 850px;
    margin: 40px auto;
    padding: 20px;
}

.welcome {
    text-align: center;
    margin-bottom: 30px;
}

.welcome h2 {
    color: #123c35;
    margin-bottom: 10px;
}

.summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 35px;
}

.card {
    background: white;
    padding: 25px;
    text-align: center;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.card h3 {
    color: #64748b;
    font-size: 16px;
}

.card p {
    color: #123c35;
    font-size: 25px;
    font-weight: bold;
    margin-top: 10px;
}

.balance-card {
    border-bottom: 5px solid #16a34a;
}

.input-section {
    background: white;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.input-section h2 {
    color: #123c35;
    margin-bottom: 15px;
}

button {
    padding: 14px 22px;
    margin-top: 20px;
    background: #123c35;
    color: white;
    border: none;
    border-radius: 7px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #1b5e50;
}

#message {
    margin-top: 18px;
    font-weight: bold;
}

footer {
    text-align: center;
    padding: 25px;
    color: #64748b;
}

@media (max-width: 600px) {
    .container {
        margin: 20px auto;
    }

    header h1 {
        font-size: 30px;
    }
}
