
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #263238;
    line-height: 1.6;
}

header {
    background: #176b55;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

header h1 {
    font-size: 36px;
    margin-bottom: 8px;
}

header p {
    font-size: 16px;
}

.container {
    width: 90%;
    max-width: 1000px;
    margin: 30px auto;
}

.welcome {
    text-align: center;
    margin-bottom: 30px;
}

.welcome h2 {
    color: #176b55;
    margin-bottom: 8px;
}

.summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.card {
    background: white;
    padding: 25px 15px;
    text-align: center;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.card h3 {
    margin-bottom: 12px;
    color: #546e7a;
}

.card p {
    font-size: 23px;
    font-weight: bold;
    color: #176b55;
}

.balance-card p {
    color: #1976d2;
}

.input-section,
.expense-section {
    background: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.input-section h2,
.expense-section h2 {
    color: #176b55;
    margin-bottom: 18px;
}

form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

input {
    flex: 1;
    min-width: 180px;
    padding: 13px;
    border: 1px solid #ccd5d8;
    border-radius: 7px;
    font-size: 16px;
}

button {
    background: #176b55;
    color: white;
    border: none;
    padding: 13px 20px;
    border-radius: 7px;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #104b3c;
}

#expenseList {
    list-style: none;
}

#expenseList li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px;
    margin-bottom: 10px;
    background: #f4f7fb;
    border-radius: 7px;
}

#expenseList li button {
    background: #d84343;
}

#expenseList li button:hover {
    background: #b52d2d;
}

#message {
    text-align: center;
    color: #176b55;
    font-weight: bold;
    margin: 20px 0;
}

footer {
    background: #176b55;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 35px;
}

@media (max-width: 650px) {
    .summary {
        grid-template-columns: 1fr;
    }

    form {
        flex-direction: column;
    }

    input {
        width: 100%;
    }

    form button {
        width: 100%;
    }

    #expenseList li {
        flex-wrap: wrap;
    }

    header h1 {
        font-size: 30px;
    }
}
